{
  "name": "@fabulu/linojava",
  "version": "0.4.0",
  "description": "Ahead-of-time browser compiler and host runtime for L.in.oleum",
  "type": "module",
  "bin": {
    "linojava": "./bin/linojava.js"
  },
  "exports": {
    ".": "./src/compiler.js",
    "./browser": "./src/browser.js",
    "./auto": "./src/auto.js",
    "./project": "./src/compiler/project-loader.js",
    "./declarations": "./src/compiler/declarations.js",
    "./expressions": "./src/compiler/expressions.js",
    "./memory-layout": "./src/compiler/memory-layout.js",
    "./programme": "./src/compiler/programme.js",
    "./operands": "./src/compiler/operands.js",
    "./linker": "./src/compiler/linker.js",
    "./project-compiler": "./src/compiler/project-compiler.js",
    "./isokernel-abi": "./src/compiler/isokernel-abi.js",
    "./intrinsics/noctis": "./src/intrinsics/noctis.js"
  },
  "scripts": {
    "build:demo": "node ./bin/linojava.js ./examples/browser_probe.lino ./examples/browser_probe.js",
    "test": "node --test"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
