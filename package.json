{
  "name": "@fabulu/linojava",
  "version": "0.2.0",
  "description": "Ahead-of-time browser compiler and host runtime for L.in.oleum",
  "type": "module",
  "bin": {
    "linojava": "./bin/linojava.js"
  },
  "exports": {
    ".": "./src/compiler.js",
