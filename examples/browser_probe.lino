"directors"
	unit = 32;

"variables"
	player_x = 154;
	player_y = 92;
	input_x = 0;
	input_y = 0;
	frame = 0;

"programme"

"start"
	A = [player_x]; A + [input_x]; [player_x] = A;
	? A >= 314 -> clamp_x_high;
	? A >= 2 -> move_y;
	A = 2; [player_x] = A; -> move_y;

"clamp_x_high"
	A = 313; [player_x] = A;

"move_y"
	A = [player_y]; A + [input_y]; [player_y] = A;
	? A >= 194 -> clamp_y_high;
	? A >= 6 -> tick;
	A = 6; [player_y] = A; -> tick;

"clamp_y_high"
	A = 193; [player_y] = A;

"tick"
	[frame]+;
	isocall;
	-> start;
